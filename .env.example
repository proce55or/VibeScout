# VibeScout — przykładowa konfiguracja. Skopiuj do `.env` i w razie potrzeby zmień.
# Plik .env NIE trafia do gita. Nie wpisuj tu żadnych prawdziwych sekretów.

# --- Serwer lokalny ---
# Adres i port panelu. Domyślnie tylko pętla zwrotna (loopback) — panel NIE jest
# wystawiany do internetu. Zmieniaj tylko świadomie.
VIBESCOUT_HOST=127.0.0.1
VIBESCOUT_PORT=4317

# --- Tryb demo ---
# 1 = izolowany tryb demonstracyjny: dane syntetyczne, kontrole sieciowe WYŁĄCZONE.
# Używany m.in. do podglądu na platformach, które nie pozwalają na pętlę zwrotną.
VIBESCOUT_DEMO=0

# --- Limity przebiegu (można też zmienić w panelu przed startem) ---
# Maksymalna liczba NOWYCH aplikacji objętych kontrolami na dobę.
VIBESCOUT_MAX_APPS_PER_DAY=20
# Zakres dat ogłoszeń wstecz (w dniach).
VIBESCOUT_LOOKBACK_DAYS=30
# Budżet odczytów źródeł na jeden przebieg (ile elementów łącznie pobrać ze źródeł).
VIBESCOUT_SOURCE_READ_BUDGET=300

# --- Retencja danych ---
# Po ilu dniach automatycznie usuwać stare projekty i raporty.
VIBESCOUT_RETENTION_DAYS=30

# --- Konektor GitHub (OPCJONALNY token) ---
# Konektor GitHub działa BEZ tokenu (limit ~10 zapytań/min). Token tylko podnosi
# limity. Utwórz darmowy "fine-grained token" bez uprawnień (tylko odczyt publiczny)
# na https://github.com/settings/tokens i wklej w prawdziwym .env (nie tutaj).
VIBESCOUT_GITHUB_TOKEN=

# --- Katalog danych ---
# Puste = domyślny katalog aplikacji systemu (np. ~/Library/Application Support/VibeScout na macOS).
# Można wskazać własną ścieżkę (poza katalogiem repozytorium).
VIBESCOUT_DATA_DIR=

# --- Opcjonalny adapter LLM (DOMYŚLNIE WYŁĄCZONY) ---
# Wersja podstawowa działa BEZ tego. Włączenie wysyła tylko minimalne, zredagowane dane.
VIBESCOUT_LLM_ENABLED=0
VIBESCOUT_LLM_ENDPOINT=
# Klucz podaj w prawdziwym .env, nie tutaj. Nigdy nie commituj klucza.
VIBESCOUT_LLM_API_KEY=
# Miesięczny limit wydatków w groszach/centach (zabezpieczenie). 0 = nie wysyłaj.
VIBESCOUT_LLM_BUDGET_CENTS=0
